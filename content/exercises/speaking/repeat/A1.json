[
  {"id": "lr-a1-01", "text": "The library is open today."},
  {"id": "lr-a1-02", "text": "I have class at nine."},
  {"id": "lr-a1-03", "text": "Where is the cafeteria?"},
  {"id": "lr-a1-04", "text": "My name is on the list."},
  {"id": "lr-a1-05", "text": "Please sit in the front row."},
  {"id": "lr-a1-06", "text": "The bus is late again."},
  {"id": "lr-a1-07", "text": "We have a test on Friday."},
  {"id": "lr-a1-08", "text": "Can I borrow your pen?"},
  {"id": "lr-a1-09", "text": "The room is on the second floor."},
  {"id": "lr-a1-10", "text": "I like my new teacher."},
  {"id": "lr-a1-11", "text": "It is very cold outside."},
  {"id": "lr-a1-12", "text": "Turn left at the corner."},
  {"id": "lr-a1-13", "text": "The coffee is too hot."},
  {"id": "lr-a1-14", "text": "Please close the door."},
  {"id": "lr-a1-15", "text": "My phone is in my bag."},
  {"id": "lr-a1-16", "text": "The office opens at eight."},
  {"id": "lr-a1-17", "text": "Do you have a map?"},
  {"id": "lr-a1-18", "text": "I live near the station."},
  {"id": "lr-a1-19", "text": "She works in a bookstore."},
  {"id": "lr-a1-20", "text": "We eat lunch at noon."},
  {"id": "lr-a1-21", "text": "The class starts in five minutes."},
  {"id": "lr-a1-22", "text": "Please write your name here."},
  {"id": "lr-a1-23", "text": "This seat is free."},
  {"id": "lr-a1-24", "text": "I need a new notebook."},
  {"id": "lr-a1-25", "text": "The park is very quiet."},
  {"id": "lr-a1-26", "text": "He walks to school every day."},
  {"id": "lr-a1-27", "text": "Is this your jacket?"},
  {"id": "lr-a1-28", "text": "The test was easy."},
  {"id": "lr-a1-29", "text": "I am from a small town."},
  {"id": "lr-a1-30", "text": "The store closes at six."},
  {"id": "lr-a1-31", "text": "Please speak more slowly."},
  {"id": "lr-a1-32", "text": "Our teacher is very kind."},
  {"id": "lr-a1-33", "text": "I drink tea every morning."},
  {"id": "lr-a1-34", "text": "The water is cold."},
  {"id": "lr-a1-35", "text": "Where do you live?"},
  {"id": "lr-a1-36", "text": "The movie starts at seven."},
  {"id": "lr-a1-37", "text": "My sister is a nurse."},
  {"id": "lr-a1-38", "text": "We play soccer on Sundays."},
  {"id": "lr-a1-39", "text": "The window is open."},
  {"id": "lr-a1-40", "text": "I have two brothers."},
  {"id": "lr-a1-41", "text": "The food here is good."},
  {"id": "lr-a1-42", "text": "Can you help me, please?"},
  {"id": "lr-a1-43", "text": "The train leaves at noon."},
  {"id": "lr-a1-44", "text": "I read the news every day."},
  {"id": "lr-a1-45", "text": "The gym is next to the pool."},
  {"id": "lr-a1-46", "text": "It is my first day here."},
  {"id": "lr-a1-47", "text": "Please turn off your phone."},
  {"id": "lr-a1-48", "text": "The weather is nice today."},
  {"id": "lr-a1-49", "text": "I study in the evening."},
  {"id": "lr-a1-50", "text": "Thank you for your help."}
]
